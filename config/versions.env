# AISC — pinned external dependency versions
# Source of truth for Dockerfile ARGs and CI
# Shell-sourceable: KEY=VALUE lines with comments

# Node.js base image (with digest for reproducible builds)
# USE_CN_MIRROR=1 时自动使用国内镜像加速源
NODE_IMAGE=node:22-slim
NODE_IMAGE_CN=docker.1ms.run/library/node:22-slim
# T8a (2.1.9 D-9): 基础镜像预拉镜像链（逗号分隔 registry 前缀）。aisc build
# 在 docker build 前逐个尝试 docker pull，成功后打本地 tag 让 buildkit 命中，
# 全链失败才报错并给指引。顺序即优先级；首项应与 NODE_IMAGE_CN 同源。
NODE_IMAGE_MIRRORS=docker.1ms.run/library,docker.m.daocloud.io/library,dockerproxy.net/library
# 0.1.0 A5 (D-10 gate fired): claude-code 2.1.273 requires node>=22 —
# base moved 20->22; mirror pre-pull verified (docker.1ms.run, 2026-09-16).
NODE_IMAGE_DIGEST=

# Claude Code (npm package)
# A5 (D-9/D-27): consumed as a build arg (factory default; user-layer
# override via `aisc update --pin-tool CLAUDE_CODE_VERSION=<ver>`).
CLAUDE_CODE_VERSION=2.1.273

# Codex CLI (npm package from OpenAI)
CODEX_VERSION=0.154.0

# Mihomo (Clash Meta) — TUN transparent proxy core
MIHOMO_VERSION=v1.19.27

# Geodata (MetaCubeX/meta-rules-dat release tag)
# All three files (geoip.metadb, geosite.dat, country.mmdb) share the same release
GEODATA_VERSION=latest  # TODO: pin to dated release tag for reproducible builds

# cc-switch-cli — cross-platform AI CLI management tool (Rust binary)
# Stage 8b: `aisc build` resolves `latest` stable LIVE (GitHub API digest,
# fail-closed); this pin is only the MANUAL `docker build` fallback and the
# rollback reference — never the latest source of truth.
# A5: unified with the resolver cache latest stable (2026-08-30) and
# Dockerfile ARG — the three-way drift (v5.9.0/v5.10.4/v5.10.1) is closed.
CC_SWITCH_VERSION=v5.10.4

# Build flags
USE_CN_MIRROR=1
GH_PROXY=
