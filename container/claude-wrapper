#!/bin/bash
# Claude 包装器：每次启动 Claude 前从 settings.json 注入 env
# 在每次启动 Claude 前重新注入 settings.json 的 env，兼容 cc-switch 实时切换。
set -e

source /usr/local/bin/lib/env-inject.sh

# env 块在 Claude CLI 原生 settings.json（CLAUDE_CONFIG_DIR/settings.json）。
# 启动时兜底注入一次；Claude Code 自身也会原生读取该文件并实时生效。
CFG_DIR="${CLAUDE_CONFIG_DIR:-/root/app/.claude}"
SETTINGS_FILE="${CFG_DIR}/settings.json"

env_inject "$SETTINGS_FILE"

# 2.1.9 O9-反馈 #5a (2026-09-02): 清屏（含回滚缓冲）——用户在 bash/zsh 手动
# 唤起 agent TUI 时执行，旧 shell 输出不再可回滚混看。Workbench agent 页签
# 直启（AISC_AGENT=claude，由 session wrapper exec 注入）不受影响；bash 会话
# 继承 AISC_AGENT=bash，外部手动 docker exec 则未注入，两者都清屏。
if [ -t 1 ] && [ "${AISC_AGENT:-manual}" != "claude" ]; then
    clear 2>/dev/null || printf '\033[H\033[2J\033[3J'
fi

# 默认以 --dangerously-skip-permissions 模式运行（跳过权限确认，适合容器内自动流）。
# 用户若已手动传入则不重复追加，避免重复 flag 报错。
skip_perm="--dangerously-skip-permissions"
has_flag=0
for a in "$@"; do
    case "$a" in
        --dangerously-skip-permissions|--permission-mode=*) has_flag=1; break ;;
    esac
done
# b1 (2.1.16 反馈 #10): CLI 内 npm install -g 自更新把新二进制装到
# NPM_CONFIG_PREFIX 指向的 toolchain prefix（project=/opt/aisc/toolchain，
# temporary/exec 会话=/tmp/aisc-toolchain）。按 会话 prefix → 持久 → 临时
# 顺序解析，命中即 exec；全部未命中才回退出厂 claude-real。wrapper 自身
# 永远留在 /usr/local/bin 解析链上，settings.json 注入不因更新旁路。
real_bin=""
for candidate in \
    "${NPM_CONFIG_PREFIX:-/nonexistent}/bin/claude" \
    /opt/aisc/toolchain/npm-global/bin/claude \
    /tmp/aisc-toolchain/npm-global/bin/claude; do
    if [ -x "$candidate" ]; then
        real_bin="$candidate"
        break
    fi
done

if [ -n "$real_bin" ]; then
    if [ "$has_flag" = "0" ]; then
        exec "$real_bin" "$skip_perm" "$@"
    else
        exec "$real_bin" "$@"
    fi
fi

if [ "$has_flag" = "0" ]; then
    exec claude-real "$skip_perm" "$@"
else
    exec claude-real "$@"
fi
