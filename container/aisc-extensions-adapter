def updates_check() -> dict[str, Any]:
    """Check updates only where a market exposes a comparable version field."""
    items: list[dict[str, Any]] = []
    for item in list_items("skills") + list_items("mcp"):
        items.append({
            "kind": item["kind"],
            "id": item["id"],
            "name": item.get("name") or item["id"],
            "status": "unsupported",
            "update_available": False,
            "latest_version": "",
            "reason": "market does not expose a comparable version field",
        })

    installed = list_items("plugins")
    available: dict[str, dict[str, Any]] = {}
    if installed:
        raw = _run_cli(["claude-real", "plugin", "list", "--available", "--json"],
                       timeout=120.0)
        available = _plugin_available_index(raw)
    for item in installed:
        market = available.get(item["id"], {})
        latest_version = str(market.get("version") or "")
        latest_sha = str(market.get("gitCommitSha") or "")
        current_version = str(item.get("version") or "")
        current_sha = str(item.get("git_commit_sha") or "")
        comparable = bool(latest_version and current_version) or bool(
            latest_sha and current_sha
        )
        changed = (
            (bool(latest_version and current_version)
             and latest_version != current_version)
            or (bool(latest_sha and current_sha) and latest_sha != current_sha)
        )
        items.append({
            "kind": "plugins",
            "id": item["id"],
            "name": item.get("name") or item["id"],
            "status": "ok" if comparable else "unsupported",
            "update_available": changed,
            "current_version": current_version,
            "current_git_commit_sha": current_sha,
            "latest_version": latest_version,
            "latest_git_commit_sha": latest_sha,
            "reason": "" if comparable else (
                "marketplace metadata unavailable" if not market else
                "market does not expose a comparable version field"
            ),
        })
    return {
        "schema": MARKET_CACHE_SCHEMA,
        "total": len(items),
        "completed": len(items),
        "items": items,
    }


