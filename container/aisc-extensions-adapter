import json
import os
import sqlite3
import re
import shlex
import subprocess
import sys
import time
import urllib.parse
import uuid
from pathlib import Path
from typing import Any, Optional

PROTOCOL = "aisc.extensions/v1"
AGENTS = ("claude", "codex")
KINDS = ("skills", "mcp", "plugins")
DB_NAME = "cc-switch.db"
CLI_TIMEOUT_S = 60.0

ERR_BAD_REQUEST = "AISC_ERR_EXTENSIONS_BAD_REQUEST"
ERR_NOT_FOUND = "AISC_ERR_EXTENSIONS_NOT_FOUND"
ERR_CLI = "AISC_ERR_EXTENSIONS_CLI_ERROR"
ERR_SNAPSHOT = "AISC_ERR_EXTENSIONS_SNAPSHOT_FAILED"


class AdapterError(Exception):
    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code
        self.message = message


def _envelope(op: str, ok: bool, *, items: Optional[list] = None,
              error: Optional[dict] = None, detail: Optional[str] = None) -> dict:
    out: dict[str, Any] = {
        "schema": PROTOCOL,
        "operation_id": str(uuid.uuid4()),
        "op": op,
        "ok": ok,
    }
    if items is not None:
        out["items"] = items
    if detail is not None:
        out["detail"] = detail
    if error is not None:
        out["error"] = error
    return out


def _db_path() -> Path:
    root = os.environ.get("CC_SWITCH_CONFIG_DIR", "")
    if not root:
        raise AdapterError(ERR_BAD_REQUEST, "CC_SWITCH_CONFIG_DIR is not set")
    return Path(root) / DB_NAME


def _connect_ro(path: Path) -> sqlite3.Connection:
    # Same WAL-safe shape as the provider adapter (mode=rw + query_only,
    # brief retry against daemon checkpoint windows).
    # Windows drive letters need the file:/// URI authority form; POSIX takes
    # the plain file: prefix. Both stay statement-level write-protected.
    raw = str(path)
    prefix = "file:///" if (len(raw) > 1 and raw[1] == ":") else "file:"
    last: sqlite3.Error | None = None
    for attempt in range(3):
        try:
            conn = sqlite3.connect(f"{prefix}{path.as_posix()}?mode=rw", timeout=10, uri=True)
            conn.execute("PRAGMA query_only = 1")
            return conn
        except sqlite3.Error as exc:
            last = exc
            time.sleep(0.2 * (attempt + 1))
    raise AdapterError(ERR_SNAPSHOT, f"cannot open {path}: {last}")


def _bool_col(value: Any) -> bool:
    return bool(value)


def _skill_items() -> list[dict[str, Any]]:
    path = _db_path()
    if not path.is_file():
        return []
    conn = _connect_ro(path)
    try:
        rows = conn.execute(
            "SELECT name, directory, description, repo_owner, repo_name, "
            "repo_branch, enabled_claude, enabled_codex, installed_at, "
            "updated_at FROM skills ORDER BY name ASC"
        ).fetchall()
    finally:
        conn.close()
    # b10 手测 #5: cross-reference installed_plugins.json for skill sources
    plugin_skill_names: set[str] = set()
    try:
        ip = Path(os.environ.get("CLAUDE_CONFIG_DIR", "/root/app/.claude")) / "plugins" / "installed_plugins.json"
        if ip.is_file():
            doc = json.loads(ip.read_text(encoding="utf-8"))
            for full_id in (doc.get("plugins", {}) or {}):
                plugin_skill_names.add(full_id.split("@")[0])
    except Exception:
        pass
    out_list: list[dict[str, Any]] = []
    for (name, directory, description, owner, repo, branch, ec, ex,
         installed, updated) in rows:
        sources = ["standalone"]
        if name in plugin_skill_names:
            sources.append("plugin")
        out_list.append({
            "kind": "skills",
            "id": name,
            "name": name,
            "directory": directory or name,
            "description": description or "",
            "repo": f"{owner}/{repo}" if owner and repo else "",
            "repo_branch": branch or "",
            "enabled_claude": _bool_col(ec),
            "enabled_codex": _bool_col(ex),
            "installed_at": installed or "",
            "updated_at": updated or "",
            "sources": sources,
            "source": "+".join(sources),
            "conflict": len(sources) > 1,
        })
    return out_list


def _mcp_summary(server_config: str) -> dict[str, Any]:
    """Transport summary WITHOUT env values (key names only — secret-free)."""
    try:
        cfg = json.loads(server_config) if server_config else {}
    except json.JSONDecodeError:
        return {"transport": "unknown"}
    if not isinstance(cfg, dict):
        return {"transport": "unknown"}
    env = cfg.get("env")
    env_keys = sorted(env.keys()) if isinstance(env, dict) else []
    if isinstance(cfg.get("url"), str):
        out = {"transport": "http", "url": cfg["url"]}
    elif isinstance(cfg.get("command"), str):
        out = {"transport": "stdio", "command": cfg["command"]}
        if isinstance(cfg.get("args"), list):
            out["args"] = [str(a) for a in cfg["args"]]
    else:
        out = {"transport": "unknown"}
    if env_keys:
        out["env_keys"] = env_keys
    return out


def _mcp_items() -> list[dict[str, Any]]:
    path = _db_path()
    if not path.is_file():
        return []
    conn = _connect_ro(path)
    try:
        rows = conn.execute(
            "SELECT id, name, server_config, enabled_claude, enabled_codex, tags "
            "FROM mcp_servers ORDER BY name ASC"
        ).fetchall()
    finally:
        conn.close()
    return [
        {
            "kind": "mcp",
            "id": sid,
            "name": name or sid,
            **_mcp_summary(server_config),
            "enabled_claude": _bool_col(ec),
            "enabled_codex": _bool_col(ex),
            "tags": (tags or "").split(",") if tags else [],
        }
        for (sid, name, server_config, ec, ex, tags) in rows
    ]


def _plugin_items() -> list[dict[str, Any]]:
    root = Path(os.environ.get("CLAUDE_CONFIG_DIR", "/root/app/.claude")) / "plugins"
    installed = root / "installed_plugins.json"
    marketplaces = root / "known_marketplaces.json"
    out: list[dict[str, Any]] = []
    try:
        doc = json.loads(installed.read_text(encoding="utf-8")) if installed.is_file() else {}
        plugins = doc.get("plugins", {}) if isinstance(doc, dict) else {}
        for full_id, entries in plugins.items():
            if not isinstance(entries, list):
                continue
            for entry in entries:
                if not isinstance(entry, dict):
                    continue
                name, _, marketplace = full_id.partition("@")
                out.append({
                    "kind": "plugins",
                    "id": full_id,
                    "name": name,
                    "marketplace": marketplace or "",
                    "scope": entry.get("scope", ""),
                    "version": entry.get("version", ""),
                    "git_commit_sha": entry.get("gitCommitSha", ""),
                    "installed_at": entry.get("installedAt", ""),
                    "last_updated": entry.get("lastUpdated", ""),
                    "agent": "claude",
                })
    except (OSError, json.JSONDecodeError) as exc:
        raise AdapterError(ERR_SNAPSHOT, f"cannot read installed plugins: {exc}")
    out.sort(key=lambda item: item["id"])
    # Marketplace freshness rides the same list call (feedback scenario 2).
    try:
        doc = json.loads(marketplaces.read_text(encoding="utf-8")) if marketplaces.is_file() else {}
        updated: dict[str, str] = {}
        if isinstance(doc, dict):
            for key, meta in doc.items():
                if isinstance(meta, dict) and meta.get("lastUpdated"):
                    updated[key] = str(meta["lastUpdated"])
        for item in out:
            item["marketplace_last_updated"] = updated.get(item["marketplace"], "")
    except (OSError, json.JSONDecodeError):
        pass
    return out


def list_items(kind: str) -> list[dict[str, Any]]:
    if kind == "skills":
        return _skill_items()
    if kind == "mcp":
        return _mcp_items()
    if kind == "plugins":
        return _plugin_items()
    raise AdapterError(ERR_BAD_REQUEST, f"unknown kind: {kind}")


def _run_cli(argv: list[str], *, timeout: float = CLI_TIMEOUT_S,
             input_text: str = "",
             env_overrides: dict[str, str] | None = None) -> str:
    # b10 手测 #3/#4: claude plugin 命令依赖 CLAUDE_CONFIG_DIR 找已装列表；
    # scope wrapper 恢复了 CC_SWITCH_CONFIG_DIR 但 adapter 经 subprocess 丢失
    # 其他 scope env —— 用 /root/app/.claude 兜底（项目模式标准路径）。
    env = os.environ.copy()
    if not env.get("CLAUDE_CONFIG_DIR"):
        env["CLAUDE_CONFIG_DIR"] = "/root/app/.claude"
    if env_overrides:
        env.update(env_overrides)
    try:
        proc = subprocess.run(
            argv, capture_output=True, text=True, timeout=timeout, check=False,
            input=input_text or None, env=env,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise AdapterError(ERR_CLI, f"{argv[0]} failed to run: {exc}")
    if proc.returncode != 0:
        tail = (proc.stderr or proc.stdout or "").strip()[-400:]
        raise AdapterError(ERR_CLI, f"{argv[0]} exit {proc.returncode}: {tail}")
    return proc.stdout or ""




_GIT_MIRRORS = ("https://ghfast.top/", "https://gh-proxy.com/")


def _git_mirror_env(mirror: str) -> dict[str, str]:
    """Rewrite only GitHub URLs through one mirror on an explicit retry."""
    return {
        "GIT_CONFIG_COUNT": "1",
        "GIT_CONFIG_KEY_0": f"url.{mirror}https://github.com/.insteadOf",
        "GIT_CONFIG_VALUE_0": "https://github.com/",
    }


def _github_repo_identity(source: str) -> tuple[tuple[str, str, Optional[str]], str] | None:
    """Normalize owner/name[@branch] or a GitHub URL for Git operations."""
    source = source.strip()
    branch: Optional[str] = None
    if source.startswith("https://github.com/"):
        path = source.removeprefix("https://github.com/").strip("/")
        if path.endswith(".git"):
            path = path[:-4]
        if "/tree/" in path:
            path, maybe_branch = path.split("/tree/", 1)
            branch = maybe_branch.split("/", 1)[0] or None
    else:
        # Keep the historical local-path escape hatch: a relative/local path
        # is not a GitHub repo and must never be rewritten through a mirror.
        if "/" not in source or Path(source).exists() or source.startswith("."):
            return None
        if "@" in source:
            source, maybe_branch = source.rsplit("@", 1)
            branch = maybe_branch or None
        path = source.strip("/")
    path = path.split(":", 1)[0].strip("/")
    parts = [part for part in path.split("/") if part]
    if len(parts) < 2:
        return None
    owner, name = parts[0], parts[1]
    return (owner, name, branch), f"https://github.com/{owner}/{name}.git"


def _github_git_env(source: str) -> dict[str, str]:
    """Probe direct GitHub first, then mirrors, with bounded diagnostics.

    Returns an empty environment for the reachable direct source. Mirror
    environments rewrite only GitHub URLs. Every failed probe is retained so
    group callers can report which transport failed instead of collapsing all
    network errors to a generic CLI failure.
    """
    identity = _github_repo_identity(source)
    if identity is None:
        return {}
    url = identity[1]
    failures: list[str] = []
    for mirror in (None, *_GIT_MIRRORS):
        env = {} if mirror is None else _git_mirror_env(mirror)
        label = "direct" if mirror is None else mirror
        try:
            _run_cli(["git", "ls-remote", url, "HEAD"],
                     timeout=8.0, env_overrides=env)
        except AdapterError as exc:
            failures.append(f"{label}: {exc.message}")
            continue
        return env
    raise AdapterError(
        ERR_CLI,
        f"github unreachable after direct and mirror probes: {url}; "
        + "; ".join(failures),
    )


def _skill_spec_parts(spec: str) -> tuple[str, str]:
    """Parse and validate the ``repo:directory`` shape before any I/O."""
    normalized = spec.strip()
    if not normalized or any(ord(char) < 32 or ord(char) == 127 for char in normalized):
        raise AdapterError(ERR_BAD_REQUEST, f"invalid skill spec: {spec!r}")
    repo, separator, directory = normalized.rpartition(":")
    if not separator:
        repo, directory = normalized, normalized
    if not repo or not directory or "\\" in directory:
        raise AdapterError(ERR_BAD_REQUEST, f"invalid skill spec: {spec!r}")
    parts = directory.split("/")
    if any(part in {"", ".", ".."} for part in parts):
        raise AdapterError(ERR_BAD_REQUEST, f"invalid skill directory: {directory!r}")
    return repo, directory


def _registered_repo_for_directory(directory: str) -> Optional[str]:
    path = _db_path()
    if not path.is_file():
        return None
    try:
        connection = _connect_ro(path)
        try:
            row = connection.execute(
                "SELECT repo_owner, repo_name FROM skills "
                "WHERE lower(directory) = lower(?) "
                "ORDER BY id LIMIT 1",
                (directory,),
            ).fetchone()
        finally:
            connection.close()
    except (OSError, sqlite3.Error, AdapterError):
        return None
    if not row or not row[0] or not row[1]:
        return None
    return f"{row[0]}/{row[1]}"


def _canonical_skill_spec(spec: str) -> str:
    """Align a market repo's casing with an already registered directory.

    cc-switch treats repository identity case-sensitively while skills.sh can
    return different casing. Reusing the registered owner/name avoids a false
    SKILL_DIRECTORY_CONFLICT when refreshing an installed group.
    """
    repo, directory = _skill_spec_parts(spec)
    registered = _registered_repo_for_directory(directory)
    if registered and registered.casefold() == repo.casefold():
        return f"{registered}:{directory}"
    return spec


def _github_branch(url: str) -> str:
    try:
        raw = _run_cli(["git", "ls-remote", "--symref", url, "HEAD"],
                       timeout=8.0)
    except AdapterError:
        raw = ""
    else:
        match = re.search(r"ref: refs/heads/([^\s]+)", raw)
        return match.group(1) if match else "main"
    for mirror in _GIT_MIRRORS:
        try:
            raw = _run_cli(["git", "ls-remote", "--symref", url, "HEAD"],
                           timeout=8.0, env_overrides=_git_mirror_env(mirror))
        except AdapterError:
            continue
        match = re.search(r"ref: refs/heads/([^\s]+)", raw)
        if match:
            return match.group(1)
    return "main"


def _archive_reachable(url: str) -> bool:
    try:
        _run_cli([
            "curl", "-fsSIL", "--connect-timeout", "5", "--max-time", "8", url,
        ], timeout=10.0)
    except AdapterError:
        return False
    return True


def _github_skill_env(source: str, *, allow_direct: bool = True) -> dict[str, str]:
    """Select direct cc-switch HTTP or a Git mirror for skill installation.

    cc-switch builds GitHub archive URLs itself. A successful Git probe is not
    sufficient (direct Git can work while GitHub's archive CDN cannot), so the
    actual archive URL is probed with a bounded HEAD request before choosing
    the direct path. Mirror archives use Git staging because cc-switch cannot
    be given a rewritten archive URL.
    """
    identity = _github_repo_identity(source)
    if identity is None:
        return {}
    (owner, name, requested_branch), url = identity
    branch = requested_branch or _github_branch(url)
    archive = (f"https://github.com/{owner}/{name}/archive/refs/heads/"
               f"{branch}.zip")
    if allow_direct and _archive_reachable(archive):
        return {}
    for mirror in _GIT_MIRRORS:
        if _archive_reachable(f"{mirror}{archive}"):
            return _git_mirror_env(mirror)
    raise AdapterError(
        ERR_CLI,
        f"github skill archive unreachable after direct and mirror probes: {archive}",
    )


def _run_cli_git_fallback(argv: list[str], *, timeout: float,
                           input_text: str = "") -> str:
    """Direct first; only if direct fails, retry public GitHub mirrors."""
    try:
        return _run_cli(argv, timeout=timeout, input_text=input_text)
    except AdapterError:
        last: AdapterError | None = None
        for mirror in _GIT_MIRRORS:
            try:
                return _run_cli(argv, timeout=timeout, input_text=input_text,
                                env_overrides=_git_mirror_env(mirror))
            except AdapterError as exc:
                last = exc
        raise last or AdapterError(ERR_CLI, "git mirror retry failed")


def _http_json(urls: list[str], *, timeout: float = 15.0) -> dict[str, Any]:
    import urllib.request
    last: Exception | None = None
    for url in urls:
        try:
            req = urllib.request.Request(
                url,
                headers={"Accept": "application/json", "User-Agent": "AISC/2.1.16"},
            )
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                data = json.loads(resp.read().decode("utf-8"))
            if isinstance(data, dict):
                return data
        except Exception as exc:
            last = exc
    raise AdapterError(ERR_CLI, f"remote request failed: {last}")


MARKET_CACHE_SCHEMA = "aisc.extensions.market-cache/v1"
MARKET_CACHE_MAX_ENTRIES = 50


def _normalized_market_query(query: str) -> str:
    return " ".join(query.casefold().split())


def _market_cache_path(kind: str, query: str) -> Path:
    root = Path(os.environ.get(
        "AISC_EXTENSION_CACHE_DIR", str(_db_path().parent / "market-cache")
    ))
    digest = hashlib.sha256(
        f"{kind}\0{_normalized_market_query(query)}".encode("utf-8")
    ).hexdigest()
    return root / f"{kind}-{digest}.json"


CACHE_FILE_RE = re.compile(r"(?:skills|mcp|plugins)-[0-9a-f]{64}\.json")


def _trim_market_cache(root: Path, limit: int = MARKET_CACHE_MAX_ENTRIES) -> None:
    """Keep only files owned by this cache schema; never touch unrelated JSON."""
    try:
        files = [path for path in root.iterdir()
                 if CACHE_FILE_RE.fullmatch(path.name) and path.is_file()]
        files.sort(key=lambda path: path.stat().st_mtime_ns, reverse=True)
        for path in files[limit:]:
            path.unlink(missing_ok=True)
    except OSError:
        return


def _write_market_cache(path: Path, kind: str, query: str,
                        items: list[dict[str, Any]]) -> int:
    fetched_at = int(time.time())
    document = {
        "schema": MARKET_CACHE_SCHEMA,
        "kind": kind,
        "query": _normalized_market_query(query),
        "fetched_at": fetched_at,
        "items": items,
    }
    temporary = path.with_suffix(path.suffix + ".tmp")
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        temporary.write_text(json.dumps(document, ensure_ascii=False), encoding="utf-8")
        temporary.replace(path)
        _trim_market_cache(path.parent)
        return fetched_at
    except OSError:
        # A successful remote refresh remains authoritative when persistence is
        # unavailable (read-only root, cache path occupied, disk full, etc.).
        try:
            temporary.unlink(missing_ok=True)
        except OSError:
            pass
        return fetched_at


def _read_market_cache(path: Path, kind: str, query: str) -> dict[str, Any] | None:
    try:
        document = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if (not isinstance(document, dict)
            or document.get("schema") != MARKET_CACHE_SCHEMA
            or document.get("kind") != kind
            or document.get("query") != _normalized_market_query(query)
            or not isinstance(document.get("items"), list)):
        return None
    return document


def _market_search_with_cache(
    kind: str, query: str, remote,
) -> dict[str, Any]:
    """Refresh first, then fall back to the last normalized-query success."""
    try:
        items = remote()
        fetched_at = _write_market_cache(
            _market_cache_path(kind, query), kind, query, items
        )
        return {
            "items": items,
            "cache": {
                "source": "remote", "cached": False,
                "query": _normalized_market_query(query),
                "fetched_at": fetched_at, "error": "",
            },
        }
    except AdapterError as exc:
        cached = _read_market_cache(_market_cache_path(kind, query), kind, query)
        if cached is None:
            raise
        return {
            "items": cached.get("items") or [],
            "cache": {
                "source": "cache", "cached": True,
                "query": _normalized_market_query(query),
                "fetched_at": int(cached.get("fetched_at") or 0),
                "error": exc.message,
            },
        }


def toggle(kind: str, item_id: str, agent: str, on: bool) -> None:
    if kind not in ("skills", "mcp"):
        raise AdapterError(ERR_BAD_REQUEST, f"toggle unsupported for kind: {kind}")
    verb = "enable" if on else "disable"
    argv = ["cc-switch", kind, verb, item_id, "-a", agent]
    _run_cli(argv)


def delete(kind: str, item_id: str) -> None:
    if kind == "skills":
        _run_cli(["cc-switch", "skills", "uninstall", item_id])
    elif kind == "mcp":
        # b7 手测 #1: `mcp delete` 的确认用 dialoguer（管道 y 无效，需真 TTY）。
        # 镜像内置 util-linux `script`：伪 PTY 执行并经 stdin 喂 y（实测通过）。
        inner = shlex.join(["cc-switch", "mcp", "delete", item_id])
        _run_cli(["script", "-qec", inner, "/dev/null"],
                 input_text="y\n", timeout=30.0)
    elif kind == "plugins":
        name = item_id.partition("@")[0]
        _run_cli(["claude-real", "plugin", "uninstall", name], timeout=120.0)
    else:
        raise AdapterError(ERR_BAD_REQUEST, f"unknown kind: {kind}")


def _skill_enable_states(directory: str) -> Optional[dict[str, bool]]:
    path = _db_path()
    if not path.is_file():
        return None
    try:
        connection = _connect_ro(path)
        try:
            row = connection.execute(
                "SELECT enabled_claude, enabled_codex FROM skills "
                "WHERE directory = ? OR name = ? ORDER BY id LIMIT 1",
                (directory, directory),
            ).fetchone()
        finally:
            connection.close()
    except (OSError, sqlite3.Error, AdapterError):
        return None
    if row is None:
        return None
    return {"claude": bool(row[0]), "codex": bool(row[1])}


def _stage_skills_from_git_source(specs: list[str], repo: str,
                                  git_env: dict[str, str]) -> list[str]:
    """Stage a repository's requested skills through one selected Git source.

    cc-switch builds GitHub archive URLs itself and ignores Git mirror config.
    A group must clone its repository once, resolve every requested child, and
    only then copy sources; a missing child is therefore found before any skill
    is staged or installed.
    """
    import shutil
    import tempfile

    identity = _github_repo_identity(repo)
    if identity is None:
        raise AdapterError(ERR_BAD_REQUEST, f"not a GitHub skill repo: {repo}")
    (owner, name, requested_branch), url = identity
    relatives: list[Path] = []
    for spec in specs:
        _, directory = _skill_spec_parts(spec)
        relatives.append(Path(directory))

    with tempfile.TemporaryDirectory(prefix="aisc-skill-mirror-") as temporary:
        clone = Path(temporary) / "repo"
        candidate_envs: list[dict[str, str]] = []
        for candidate in (git_env, {}, *(_git_mirror_env(mirror)
                                          for mirror in _GIT_MIRRORS)):
            marker = candidate.get("GIT_CONFIG_KEY_0", "")
            if marker not in [item.get("GIT_CONFIG_KEY_0", "")
                              for item in candidate_envs]:
                candidate_envs.append(candidate)

        clone_failures: list[str] = []
        selected_env: dict[str, str] = {}
        for candidate in candidate_envs:
            label = "direct"
            key = candidate.get("GIT_CONFIG_KEY_0", "")
            for mirror in _GIT_MIRRORS:
                if mirror in key:
                    label = mirror
                    break
            if clone.exists():
                shutil.rmtree(clone)
            clone_argv = ["git", "clone", "--depth", "1"]
            if requested_branch:
                clone_argv.extend(["--branch", requested_branch])
            clone_argv.extend([url, str(clone)])
            try:
                _run_cli(clone_argv, timeout=120.0, env_overrides=candidate)
            except AdapterError as exc:
                clone_failures.append(f"clone {label}: {exc.message}")
                continue
            selected_env = candidate
            break
        else:
            raise AdapterError(
                ERR_CLI,
                f"github skill repository clone failed for all sources: {url}; "
                + "; ".join(clone_failures),
            )

        branch = _run_cli(
            ["git", "-C", str(clone), "rev-parse", "--abbrev-ref", "HEAD"],
            timeout=10.0, env_overrides=selected_env,
        ).strip() or requested_branch or "main"
        _run_cli(["cc-switch", "skills", "repos", "add",
                  f"{owner}/{name}@{branch}"], timeout=30.0)

        sources: list[tuple[Path, Path]] = []
        missing: list[str] = []
        for spec, relative in zip(specs, relatives):
            candidates = [clone / "skills" / relative, clone / relative]
            source = next((candidate for candidate in candidates
                           if (candidate / "SKILL.md").is_file()), None)
            if source is None:
                missing.append(spec)
            else:
                sources.append((source, relative))
        if missing:
            return missing

        for source, relative in sources:
            destination = _db_path().parent / "skills" / relative
            destination.parent.mkdir(parents=True, exist_ok=True)
            if destination.exists():
                shutil.rmtree(destination)
            shutil.copytree(source, destination)
    return []


