def _parse_market_table(raw: str) -> list[dict[str, Any]]:
    """Parse `cc-switch skills market` unicode-table rows into items."""
    out: list[dict[str, Any]] = []
    for line in raw.splitlines():
        line = line.strip()
        if not (line.startswith("│") and line.endswith("│")):
            continue
        cells = [cell.strip() for cell in line[1:-1].split("┆")]
        if len(cells) < 5 or cells[0] in {"Key", "ID"}:
            continue
        if "/" not in cells[0] or not cells[1]:
            continue
        out.append({
            "kind": "market-skill",
            "id": cells[0],
            "name": cells[2] or cells[1],
            "directory": cells[1],
            "installs": cells[3],
            "repo": cells[4],
        })
    return out


def _parse_skills_api(data: dict[str, Any]) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    for item in data.get("skills", []):
        if not isinstance(item, dict) or not item.get("source") or not item.get("skillId"):
            continue
        source = str(item["source"])
        directory = str(item["skillId"])
        out.append({
            "kind": "market-skill",
            "id": f"{source}:{directory}",
            "name": str(item.get("name") or directory),
            "directory": directory,
            "installs": str(item.get("installs", "")),
            "repo": source,
            "updated_at": str(item.get("updatedAt") or item.get("updatedAtISO") or ""),
        })
    return out[:20]


def _skill_search_remote(query: str) -> list[dict[str, Any]]:
