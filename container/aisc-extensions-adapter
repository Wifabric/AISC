def _skill_repo_identity(source: str) -> str:
    value = source.strip()
    if "://" in value:
        parsed = urllib.parse.urlparse(value)
        if parsed.scheme not in {"http", "https"} or not parsed.netloc:
            raise AdapterError(ERR_BAD_REQUEST, f"invalid repository URL: {source}")
        parts = [part for part in parsed.path.split("/") if part]
        if len(parts) < 2:
            raise AdapterError(ERR_BAD_REQUEST, f"repository URL has no owner/name: {source}")
        value = f"{parts[0]}/{parts[1].removesuffix('.git')}"
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", value):
        raise AdapterError(ERR_BAD_REQUEST, f"invalid repository identity: {source}")
    return value


