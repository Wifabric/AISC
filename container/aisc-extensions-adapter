def _skill_group_operation(specs: list[str], *, update: bool) -> dict[str, Any]:
    if not isinstance(specs, list) or not specs or not all(
        isinstance(spec, str) and spec.strip() for spec in specs
    ):
        raise AdapterError(ERR_BAD_REQUEST, "non-empty skill specs are required")

    unique: list[str] = []
    seen: set[str] = set()
    for spec in specs:
        normalized = _canonical_skill_spec(spec.strip())
        if normalized not in seen:
            seen.add(normalized)
            unique.append(normalized)

    grouped: dict[str, list[str]] = {}
    for spec in unique:
        repo, _ = _skill_spec_parts(spec)
        grouped.setdefault(repo, []).append(spec)

    items: list[dict[str, Any]] = [
        {"spec": spec, "status": "pending", "error": ""} for spec in unique
    ]
    previous_states: dict[str, dict[str, bool]] = {}
    if update:
        state_errors: dict[str, str] = {}
        for spec in unique:
            _, directory = _skill_spec_parts(spec)
            state = _skill_enable_states(directory)
            if state is None:
                state_errors[spec] = "enable state unavailable in cc-switch SSOT"
            else:
                previous_states[spec] = state
        if state_errors:
            for item in items:
                if item["spec"] in state_errors:
                    item["status"] = "state_unavailable"
                    item["error"] = state_errors[item["spec"]]
                else:
                    item["status"] = "blocked"
                    item["error"] = "skill group enable-state preflight failed"
            return {"total": len(items), "completed": 0, "items": items}

    source_errors: dict[str, str] = {}
    missing_errors: dict[str, str] = {}
    for repo, group_specs in grouped.items():
        try:
            if _github_repo_identity(repo) is None:
                continue
            git_env = _github_git_env(repo)
            missing = _stage_skills_from_git_source(group_specs, repo, git_env)
            for spec in missing:
                missing_errors[spec] = (
                    f"SKILL.md not found for {spec} in selected repository source"
                )
        except AdapterError as exc:
            for spec in group_specs:
                source_errors[spec] = f"repo {repo}: {exc.message}"

    if source_errors or missing_errors:
        for item in items:
            spec = item["spec"]
            if spec in missing_errors:
                item["status"] = "missing"
                item["error"] = missing_errors[spec]
            elif spec in source_errors:
                item["status"] = "source_failed"
                item["error"] = source_errors[spec]
            else:
                item["status"] = "blocked"
                item["error"] = "skill group source preflight failed"
        return {"total": len(items), "completed": 0, "items": items}

    final_status = "updated" if update else "installed"
    for item in items:
        spec = item["spec"]
        repo, directory = _skill_spec_parts(spec)
        try:
            _run_cli(["cc-switch", "skills", "install", spec], timeout=120.0)
            if update:
                previous = previous_states.get(spec)
                if previous is None:
                    raise AdapterError(
                        ERR_CLI, f"enable state lost before update: {spec}")
                for agent in AGENTS:
                    verb = "enable" if previous[agent] else "disable"
                    _run_cli(["cc-switch", "skills", verb, directory,
                              "-a", agent])
            else:
                for agent in AGENTS:
                    _run_cli(["cc-switch", "skills", "enable", directory,
                              "-a", agent])
            item["status"] = final_status
        except AdapterError as exc:
            item["status"] = "failed"
            item["error"] = exc.message

    completed = sum(item["status"] == final_status for item in items)
    return {"total": len(items), "completed": completed, "items": items}


def skill_install_group(specs: list[str]) -> dict[str, Any]:
    """Install a repository group with one source fetch and itemized results."""
    return _skill_group_operation(specs, update=False)


def skill_update_group(specs: list[str]) -> dict[str, Any]:
