    parser.add_argument("--id")
    parser.add_argument("--agent", choices=list(AGENTS))
    parser.add_argument("--on", choices=["true", "false"], default="true")
    parser.add_argument("--spec", help="skill-install: owner/name:directory")
    parser.add_argument("--specs", help="group ops: JSON array of specs")
    parser.add_argument("--apps", default="claude,codex",
                        help="mcp-add: comma-separated agent list")
    args = parser.parse_args(argv)

    try:
        if args.op == "list":
            if not args.kind:
                raise AdapterError(ERR_BAD_REQUEST, "--kind is required")
            print(json.dumps(_envelope("list", True, items=list_items(args.kind))))
            return 0
        if args.op == "toggle":
            if not (args.kind and args.id and args.agent):
                raise AdapterError(ERR_BAD_REQUEST, "--kind/--id/--agent required")
            toggle(args.kind, args.id, args.agent, args.on == "true")
            print(json.dumps(_envelope("toggle", True)))
            return 0
        if args.op == "delete":
            if not (args.kind and args.id):
                raise AdapterError(ERR_BAD_REQUEST, "--kind/--id required")
            delete(args.kind, args.id)
            print(json.dumps(_envelope("delete", True)))
            return 0
        if args.op == "skill-install":
            if not args.spec:
                raise AdapterError(ERR_BAD_REQUEST, "--spec required")
            skill_install(args.spec)
            print(json.dumps(_envelope("skill-install", True)))
            return 0
        if args.op in ("skill-install-group", "skill-update-group"):
            if not args.specs:
                raise AdapterError(ERR_BAD_REQUEST, "--specs required")
            try:
                parsed_specs = json.loads(args.specs)
            except json.JSONDecodeError as exc:
                raise AdapterError(ERR_BAD_REQUEST, f"invalid --specs JSON: {exc}")
            if not isinstance(parsed_specs, list) or not all(
                isinstance(spec, str) and spec.strip() for spec in parsed_specs
            ):
                raise AdapterError(ERR_BAD_REQUEST, "--specs must be a JSON string array")
            specs = parsed_specs
            if args.op == "skill-install-group":
                result = skill_install_group(specs)
            else:
                result = skill_update_group(specs)
            envelope = _envelope(args.op, True)
            envelope.update(result)
            print(json.dumps(envelope))
            return 0
        if args.op == "mcp-add":
            config_json = sys.stdin.read().strip()
            if not config_json:
                raise AdapterError(ERR_BAD_REQUEST, "MCP config JSON required on stdin")
            mcp_add(config_json, [a for a in args.apps.split(",") if a])
            print(json.dumps(_envelope("mcp-add", True)))
            return 0
        if args.op == "plugin-install":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            plugin_install(args.id)
            print(json.dumps(_envelope("plugin-install", True)))
            return 0
        if args.op == "plugin-uninstall":
            if not (args.kind and args.id):
                raise AdapterError(ERR_BAD_REQUEST, "--kind/--id required")
            delete("plugins", args.id)
            print(json.dumps(_envelope("plugin-uninstall", True)))
            return 0
        if args.op == "plugin-update":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            plugin_update(args.id)
            print(json.dumps(_envelope("plugin-update", True)))
            return 0
        if args.op == "skill-update":
            if not args.spec:
                raise AdapterError(ERR_BAD_REQUEST, "--spec required")
            skill_update(args.spec)
            print(json.dumps(_envelope("skill-update", True)))
            return 0
        if args.op == "updates-check":
            result = updates_check()
            result.pop("schema", None)
            envelope = _envelope("updates-check", True)
            envelope.update(result)
            print(json.dumps(envelope))
            return 0
        if args.op == "skill-search":
            if not args.query:
                raise AdapterError(ERR_BAD_REQUEST, "--query required")
            result = skill_search_result(args.query)
            envelope = _envelope("skill-search", True, items=result["items"])
            envelope["cache"] = result["cache"]
            print(json.dumps(envelope))
            return 0
        if args.op == "deeplink":
            if not args.url:
                raise AdapterError(ERR_BAD_REQUEST, "--url required")
            deeplink_import(args.url)
            print(json.dumps(_envelope("deeplink", True)))
            return 0
        if args.op == "skill-repo-add":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            skill_repo_add(args.id)
            print(json.dumps(_envelope("skill-repo-add", True)))
            return 0
        if args.op == "skill-repos-list":
            print(json.dumps(_envelope(
                "skill-repos-list", True, items=skill_repos_list())))
            return 0
        if args.op == "skill-repo-remove":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            skill_repo_remove(args.id)
            print(json.dumps(_envelope("skill-repo-remove", True)))
            return 0
        if args.op == "plugin-market-list":
            print(json.dumps(_envelope(
                "plugin-market-list", True, items=plugin_market_list())))
            return 0
        if args.op == "plugin-market-add":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            plugin_market_add(args.id)
            print(json.dumps(_envelope("plugin-market-add", True)))
            return 0
        if args.op == "plugin-market-remove":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            plugin_market_remove(args.id)
            print(json.dumps(_envelope("plugin-market-remove", True)))
            return 0
        if args.op == "plugin-search":
            if not args.query:
                raise AdapterError(ERR_BAD_REQUEST, "--query required")
            result = plugin_search_result(args.query)
            envelope = _envelope("plugin-search", True, items=result["items"])
            envelope["cache"] = result["cache"]
            print(json.dumps(envelope))
            return 0
        if args.op == "mcp-search":
            if not args.query:
                raise AdapterError(ERR_BAD_REQUEST, "--query required")
            result = mcp_search_result(args.query)
            envelope = _envelope("mcp-search", True, items=result["items"])
            envelope["cache"] = result["cache"]
            print(json.dumps(envelope))
            return 0
        if args.op == "mcp-market-install":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            config = mcp_market_install(args.id)
            mcp_add(config, ["claude", "codex"])
            print(json.dumps(_envelope("mcp-market-install", True)))
            return 0
        raise AdapterError(ERR_BAD_REQUEST, f"unhandled op: {args.op}")
    except AdapterError as exc:
        print(json.dumps(_envelope(
            args.op, False,
            error={"code": exc.code, "message": exc.message},
        )))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
