def _install_skill(spec: str, *, enable_both: bool,
                   restore_state: bool = False) -> None:
    # b9 手测 #2: 市场安装的 key 是 owner/name:directory——若仓库尚未注册，
    # install 直接 SKILL_DIR_NOT_FOUND。先 best-effort repos add（已注册时
    # cc-switch 幂等），失败不拦截（目录名直装仍是合法形态）。
    repo, directory = _skill_spec_parts(spec)
    previous_state = _skill_enable_states(directory) if restore_state else None
    git_env = _github_skill_env(repo)
    if git_env:
        _stage_skill_from_git_source_one(spec, repo, git_env)
        _run_cli(["cc-switch", "skills", "install", spec], timeout=120.0)
    else:
        if "/" in repo and not Path(repo).exists() and not repo.startswith("."):
            try:
                _run_cli(["cc-switch", "skills", "repos", "add", repo],
                         timeout=120.0)
            except AdapterError:
                pass
        try:
            _run_cli(["cc-switch", "skills", "install", spec], timeout=120.0)
        except AdapterError:
            # A HEAD probe can succeed while the real archive body still fails.
            # Retry once through Git staging; this does not enable system proxy.
            mirror_env = _github_skill_env(repo, allow_direct=False)
            if not mirror_env:
                raise
            _stage_skill_from_git_source_one(spec, repo, mirror_env)
            _run_cli(["cc-switch", "skills", "install", spec], timeout=120.0)
    if enable_both:
        for agent in AGENTS:
            _run_cli(["cc-switch", "skills", "enable", directory, "-a", agent])
    elif previous_state is not None:
        for agent in AGENTS:
            verb = "enable" if previous_state[agent] else "disable"
            _run_cli(["cc-switch", "skills", verb, directory, "-a", agent])

def skill_install(spec: str) -> None:
    # preview b2 用户裁定：市场安装默认 Claude + Codex 均启用。
    _install_skill(spec, enable_both=True)


