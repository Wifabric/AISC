def _parse_market_table(raw: str) -> list[dict[str, Any]]:
    """Parse `cc-switch skills market` unicode-table rows into items."""
    out: list[dict[str, Any]] = []
    for line in raw.splitlines():
        line = line.strip()
        if not (line.startswith("│") and line.endswith("│")):
            continue
        cells = [cell.strip() for cell in line[1:-1].split("┆")]
        if len(cells) < 5 or cells[0] in {"Key", "ID"}:
            continue
        if "/" not in cells[0] or not cells[1]:
            continue
        out.append({
            "kind": "market-skill",
            "id": cells[0],
            "name": cells[2] or cells[1],
            "directory": cells[1],
            "installs": cells[3],
            "repo": cells[4],
        })
    return out


def skill_search(query: str) -> list[dict[str, Any]]:
    if not query.strip():
        raise AdapterError(ERR_BAD_REQUEST, "search query is required")
    raw = _run_cli(
        ["cc-switch", "skills", "market", query, "--limit", "20"], timeout=60.0
    )
    return _parse_market_table(raw)


def deeplink_import(url: str) -> None:
    if not url.startswith("ccswitch://"):
        raise AdapterError(ERR_BAD_REQUEST, "url must start with ccswitch://")
    _run_cli(["cc-switch", "deeplink", url], timeout=60.0)


def skill_repo_add(source: str) -> None:
    if not source.strip():
        raise AdapterError(ERR_BAD_REQUEST, "repo source is required")
    _run_cli(["cc-switch", "skills", "repos", "add", source], timeout=120.0)


def _parse_plugin_marketplaces(raw: str) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    name = ""
    for line in raw.splitlines():
        arrow = line.find("❯")
        if arrow >= 0:
            name = line[arrow + 1:].strip()
            continue
        if name and line.strip().startswith("Source:"):
            out.append({"kind": "marketplace", "id": name, "name": name,
                        "source": line.strip().removeprefix("Source:").strip()})
            name = ""
    return out


def plugin_market_list() -> list[dict[str, Any]]:
    raw = _run_cli(["claude-real", "plugin", "marketplace", "list"], timeout=60.0)
    return _parse_plugin_marketplaces(raw)


def plugin_market_add(source: str) -> None:
    if not source.strip():
        raise AdapterError(ERR_BAD_REQUEST, "marketplace source is required")
    _run_cli(["claude-real", "plugin", "marketplace", "add", source],
             timeout=180.0)

def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="aisc-extensions-adapter")
    parser.add_argument("op", choices=["list", "toggle", "delete", "skill-install",
                                       "mcp-add", "plugin-install",
                                       "plugin-uninstall", "plugin-update",
                                       "skill-search", "deeplink",
                                       "skill-repo-add", "plugin-market-list",
                                       "plugin-market-add"])
    parser.add_argument("--query", help="skill-search: marketplace query")
    parser.add_argument("--url", help="deeplink: ccswitch://… URL")
    parser.add_argument("--kind", choices=list(KINDS))
    parser.add_argument("--id")
    parser.add_argument("--agent", choices=list(AGENTS))
    parser.add_argument("--on", choices=["true", "false"], default="true")
    parser.add_argument("--spec", help="skill-install: owner/name:directory")
    parser.add_argument("--apps", default="claude,codex",
                        help="mcp-add: comma-separated agent list")
    args = parser.parse_args(argv)

    try:
        if args.op == "list":
            if not args.kind:
                raise AdapterError(ERR_BAD_REQUEST, "--kind is required")
            print(json.dumps(_envelope("list", True, items=list_items(args.kind))))
            return 0
        if args.op == "toggle":
            if not (args.kind and args.id and args.agent):
                raise AdapterError(ERR_BAD_REQUEST, "--kind/--id/--agent required")
            toggle(args.kind, args.id, args.agent, args.on == "true")
            print(json.dumps(_envelope("toggle", True)))
            return 0
        if args.op == "delete":
            if not (args.kind and args.id):
                raise AdapterError(ERR_BAD_REQUEST, "--kind/--id required")
            delete(args.kind, args.id)
            print(json.dumps(_envelope("delete", True)))
            return 0
        if args.op == "skill-install":
            if not args.spec:
                raise AdapterError(ERR_BAD_REQUEST, "--spec required")
            skill_install(args.spec)
            print(json.dumps(_envelope("skill-install", True)))
            return 0
        if args.op == "mcp-add":
            config_json = sys.stdin.read().strip()
            if not config_json:
                raise AdapterError(ERR_BAD_REQUEST, "MCP config JSON required on stdin")
            mcp_add(config_json, [a for a in args.apps.split(",") if a])
            print(json.dumps(_envelope("mcp-add", True)))
            return 0
        if args.op == "plugin-install":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            plugin_install(args.id)
            print(json.dumps(_envelope("plugin-install", True)))
            return 0
        if args.op == "plugin-uninstall":
            if not (args.kind and args.id):
                raise AdapterError(ERR_BAD_REQUEST, "--kind/--id required")
            delete("plugins", args.id)
            print(json.dumps(_envelope("plugin-uninstall", True)))
            return 0
        if args.op == "plugin-update":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            plugin_update(args.id)
            print(json.dumps(_envelope("plugin-update", True)))
            return 0
        if args.op == "skill-search":
            if not args.query:
                raise AdapterError(ERR_BAD_REQUEST, "--query required")
            print(json.dumps(_envelope(
                "skill-search", True, items=skill_search(args.query))))
            return 0
        if args.op == "deeplink":
            if not args.url:
                raise AdapterError(ERR_BAD_REQUEST, "--url required")
            deeplink_import(args.url)
            print(json.dumps(_envelope("deeplink", True)))
            return 0
        if args.op == "skill-repo-add":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            skill_repo_add(args.id)
            print(json.dumps(_envelope("skill-repo-add", True)))
            return 0
        if args.op == "plugin-market-list":
            print(json.dumps(_envelope(
                "plugin-market-list", True, items=plugin_market_list())))
            return 0
        if args.op == "plugin-market-add":
            if not args.id:
                raise AdapterError(ERR_BAD_REQUEST, "--id required")
            plugin_market_add(args.id)
            print(json.dumps(_envelope("plugin-market-add", True)))
            return 0
        raise AdapterError(ERR_BAD_REQUEST, f"unhandled op: {args.op}")
    except AdapterError as exc:
        print(json.dumps(_envelope(
            args.op, False,
            error={"code": exc.code, "message": exc.message},
        )))
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
