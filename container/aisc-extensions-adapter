def mcp_search_result(query: str) -> dict[str, Any]:
    """Search Smithery; registry is primary and api.smithery.ai is a fallback."""
    import urllib.parse
    if not query.strip():
        raise AdapterError(ERR_BAD_REQUEST, "search query is required")
    def remote() -> list[dict[str, Any]]:
        encoded = urllib.parse.quote(query)
        data = _http_json([
            f"https://registry.smithery.ai/servers?q={encoded}&pageSize=10",
            f"https://api.smithery.ai/servers?q={encoded}&pageSize=10",
        ], timeout=15.0)
        servers = data.get("servers", []) if isinstance(data, dict) else []
        out: list[dict[str, Any]] = []
        for server in servers:
            if not isinstance(server, dict):
                continue
            out.append({
                "kind": "market-mcp",
                "id": server.get("qualifiedName") or server.get("name") or "",
                "name": server.get("displayName") or server.get("name") or "",
                "description": (server.get("description") or "")[:200],
                "repo": server.get("repository", {}).get("url", "")
                        if isinstance(server.get("repository"), dict) else "",
                "source": "smithery",
                "installs": str(server.get("useCount", "")),
                "created_at": str(server.get("createdAt", "")),
                "updated_at": str(server.get("updatedAt") or server.get("createdAt") or ""),
            })
        return out
    return _market_search_with_cache("mcp", query, remote)


def mcp_market_install(market_id: str) -> str:
    """Fetch a Smithery server and build an MCP config.

    Smithery's deployed servers expose an HTTP connection URL. Legacy local
    command metadata is supported as a fallback, but must not be required.
    """
    data = _http_json([
        f"https://registry.smithery.ai/servers/{market_id}",
        f"https://api.smithery.ai/servers/{market_id}",
    ], timeout=15.0)
    server = data if isinstance(data, dict) else {}
    connections = server.get("connections")
    http_url = ""
    if isinstance(connections, list):
        for connection in connections:
            if (isinstance(connection, dict) and connection.get("type") == "http"
                    and connection.get("deploymentUrl")):
                http_url = str(connection["deploymentUrl"])
                break
    if not http_url and server.get("deploymentUrl"):
        http_url = str(server["deploymentUrl"])
    name = market_id.rsplit("/", 1)[-1]
    if http_url:
        server_config = {"url": http_url}
    else:
        cmd = server.get("command") or ""
        args = server.get("args") or []
        if not cmd:
            raise AdapterError(ERR_CLI, f"Smithery server {market_id} has no HTTP URL or command")
        server_config = {"command": cmd, "args": args if isinstance(args, list) else []}
    return json.dumps({"mcpServers": {name: server_config}})


