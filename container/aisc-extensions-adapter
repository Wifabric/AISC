    parser = argparse.ArgumentParser(prog="aisc-extensions-adapter")
    parser.add_argument("op", choices=["list", "toggle", "delete", "skill-install",
                                       "skill-install-group", "mcp-add",
                                       "plugin-install",
                                       "plugin-uninstall", "plugin-update",
                                       "skill-search", "deeplink",
                                       "skill-repo-add", "skill-update", "skill-update-group",
                                       "skill-repos-list", "skill-repo-remove",
                                       "plugin-market-list",
                                       "plugin-market-add", "plugin-market-remove",
                                       "plugin-search",
                                       "mcp-search", "mcp-market-install",
                                       "updates-check"])
    parser.add_argument("--query", help="marketplace query (skill/plugin/MCP)")
    parser.add_argument("--url", help="deeplink: ccswitch://… URL")
