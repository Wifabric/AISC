#!/usr/bin/python3
"""AISC extensions adapter (container-side, v2.1.16 b5).

Implements the ``aisc.extensions/v1`` data plane INSIDE the runtime container:

  list            -- kind=skills|mcp|plugins: read-only snapshot
                     (skills/mcp: cc-switch SQLite SSOT; plugins:
                     Claude installed_plugins.json + marketplaces)
  toggle          -- enable/disable a skill or MCP server for one agent
  delete          -- uninstall a skill / delete an MCP server / remove a
                     Claude plugin
  skill-install   -- cc-switch skills install <owner/name:directory>
  mcp-add         -- non-interactive deeplink import (the interactive
                     `mcp add` TUI is unusable from docker exec):
                     ccswitch://v1/import?resource=mcp&config=<b64>&apps=...
  plugin-install  -- claude plugin install <name@marketplace>
  plugin-uninstall-- claude plugin uninstall <name>
  plugin-update   -- claude plugin update <name>

User ruling 2026-10-18 (b4 D-1..D-4): rail navigation; plugins are directly
installable/uninstallable in P1; MCP add ships in P1.

Envelope output mirrors aisc-cc-provider: {"schema", "operation_id", "op",
"ok", ...}; errors carry a stable AISC_ERR_EXTENSIONS_* code. MCP
server_config env VALUES never leave this process (key names only).
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import sqlite3
import re
import shlex
import subprocess
import sys
import time
import urllib.parse
import uuid
from pathlib import Path
from typing import Any, Optional

PROTOCOL = "aisc.extensions/v1"
AGENTS = ("claude", "codex")
KINDS = ("skills", "mcp", "plugins")
DB_NAME = "cc-switch.db"
CLI_TIMEOUT_S = 60.0

ERR_BAD_REQUEST = "AISC_ERR_EXTENSIONS_BAD_REQUEST"
ERR_NOT_FOUND = "AISC_ERR_EXTENSIONS_NOT_FOUND"
ERR_CLI = "AISC_ERR_EXTENSIONS_CLI_ERROR"
ERR_SNAPSHOT = "AISC_ERR_EXTENSIONS_SNAPSHOT_FAILED"


class AdapterError(Exception):
    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code = code
        self.message = message


def _envelope(op: str, ok: bool, *, items: Optional[list] = None,
              error: Optional[dict] = None, detail: Optional[str] = None) -> dict:
    out: dict[str, Any] = {
        "schema": PROTOCOL,
        "operation_id": str(uuid.uuid4()),
        "op": op,
        "ok": ok,
    }
    if items is not None:
        out["items"] = items
    if detail is not None:
        out["detail"] = detail
    if error is not None:
        out["error"] = error
    return out


def _db_path() -> Path:
    root = os.environ.get("CC_SWITCH_CONFIG_DIR", "")
    if not root:
        raise AdapterError(ERR_BAD_REQUEST, "CC_SWITCH_CONFIG_DIR is not set")
    return Path(root) / DB_NAME


def _connect_ro(path: Path) -> sqlite3.Connection:
    # Same WAL-safe shape as the provider adapter (mode=rw + query_only,
    # brief retry against daemon checkpoint windows).
    # Windows drive letters need the file:/// URI authority form; POSIX takes
    # the plain file: prefix. Both stay statement-level write-protected.
    raw = str(path)
    prefix = "file:///" if (len(raw) > 1 and raw[1] == ":") else "file:"
    last: sqlite3.Error | None = None
    for attempt in range(3):
        try:
            conn = sqlite3.connect(f"{prefix}{path.as_posix()}?mode=rw", timeout=10, uri=True)
            conn.execute("PRAGMA query_only = 1")
            return conn
        except sqlite3.Error as exc:
            last = exc
            time.sleep(0.2 * (attempt + 1))
    raise AdapterError(ERR_SNAPSHOT, f"cannot open {path}: {last}")


def _bool_col(value: Any) -> bool:
    return bool(value)


def _skill_items() -> list[dict[str, Any]]:
    path = _db_path()
    if not path.is_file():
        return []
    conn = _connect_ro(path)
    try:
        rows = conn.execute(
            "SELECT name, description, repo_owner, repo_name, repo_branch, "
            "enabled_claude, enabled_codex, installed_at, updated_at "
            "FROM skills ORDER BY name ASC"
        ).fetchall()
    finally:
        conn.close()
    return [
        {
            "kind": "skills",
            "id": name,
            "name": name,
            "description": description or "",
            "repo": f"{owner}/{repo}" if owner and repo else "",
            "repo_branch": branch or "",
            "enabled_claude": _bool_col(ec),
            "enabled_codex": _bool_col(ex),
            "installed_at": installed or "",
            "updated_at": updated or "",
        }
        for (name, description, owner, repo, branch, ec, ex, installed, updated)
        in rows
    ]


def _mcp_summary(server_config: str) -> dict[str, Any]:
    """Transport summary WITHOUT env values (key names only — secret-free)."""
    try:
        cfg = json.loads(server_config) if server_config else {}
    except json.JSONDecodeError:
        return {"transport": "unknown"}
    if not isinstance(cfg, dict):
        return {"transport": "unknown"}
    env = cfg.get("env")
    env_keys = sorted(env.keys()) if isinstance(env, dict) else []
    if isinstance(cfg.get("url"), str):
        out = {"transport": "http", "url": cfg["url"]}
    elif isinstance(cfg.get("command"), str):
        out = {"transport": "stdio", "command": cfg["command"]}
        if isinstance(cfg.get("args"), list):
            out["args"] = [str(a) for a in cfg["args"]]
    else:
        out = {"transport": "unknown"}
    if env_keys:
        out["env_keys"] = env_keys
    return out


def _mcp_items() -> list[dict[str, Any]]:
    path = _db_path()
    if not path.is_file():
        return []
    conn = _connect_ro(path)
    try:
        rows = conn.execute(
            "SELECT id, name, server_config, enabled_claude, enabled_codex, tags "
            "FROM mcp_servers ORDER BY name ASC"
        ).fetchall()
    finally:
        conn.close()
    return [
        {
            "kind": "mcp",
            "id": sid,
            "name": name or sid,
            **_mcp_summary(server_config),
            "enabled_claude": _bool_col(ec),
            "enabled_codex": _bool_col(ex),
            "tags": (tags or "").split(",") if tags else [],
        }
        for (sid, name, server_config, ec, ex, tags) in rows
    ]


def _plugin_items() -> list[dict[str, Any]]:
    root = Path(os.environ.get("CLAUDE_CONFIG_DIR", "/root/app/.claude")) / "plugins"
    installed = root / "installed_plugins.json"
    marketplaces = root / "known_marketplaces.json"
    out: list[dict[str, Any]] = []
    try:
        doc = json.loads(installed.read_text(encoding="utf-8")) if installed.is_file() else {}
        plugins = doc.get("plugins", {}) if isinstance(doc, dict) else {}
        for full_id, entries in plugins.items():
            if not isinstance(entries, list):
                continue
            for entry in entries:
                if not isinstance(entry, dict):
                    continue
                name, _, marketplace = full_id.partition("@")
                out.append({
                    "kind": "plugins",
                    "id": full_id,
                    "name": name,
                    "marketplace": marketplace or "",
                    "scope": entry.get("scope", ""),
                    "version": entry.get("version", ""),
                    "git_commit_sha": entry.get("gitCommitSha", ""),
                    "installed_at": entry.get("installedAt", ""),
                    "last_updated": entry.get("lastUpdated", ""),
                    "agent": "claude",
                })
    except (OSError, json.JSONDecodeError) as exc:
        raise AdapterError(ERR_SNAPSHOT, f"cannot read installed plugins: {exc}")
    out.sort(key=lambda item: item["id"])
    # Marketplace freshness rides the same list call (feedback scenario 2).
    try:
        doc = json.loads(marketplaces.read_text(encoding="utf-8")) if marketplaces.is_file() else {}
        updated: dict[str, str] = {}
        if isinstance(doc, dict):
            for key, meta in doc.items():
                if isinstance(meta, dict) and meta.get("lastUpdated"):
                    updated[key] = str(meta["lastUpdated"])
        for item in out:
            item["marketplace_last_updated"] = updated.get(item["marketplace"], "")
    except (OSError, json.JSONDecodeError):
        pass
    return out


def list_items(kind: str) -> list[dict[str, Any]]:
    if kind == "skills":
        return _skill_items()
    if kind == "mcp":
        return _mcp_items()
    if kind == "plugins":
        return _plugin_items()
    raise AdapterError(ERR_BAD_REQUEST, f"unknown kind: {kind}")


def _run_cli(argv: list[str], *, timeout: float = CLI_TIMEOUT_S,
             input_text: str = "") -> str:
    try:
        proc = subprocess.run(
            argv, capture_output=True, text=True, timeout=timeout, check=False,
            input=input_text or None,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise AdapterError(ERR_CLI, f"{argv[0]} failed to run: {exc}")
    if proc.returncode != 0:
        tail = (proc.stderr or proc.stdout or "").strip()[-400:]
        raise AdapterError(ERR_CLI, f"{argv[0]} exit {proc.returncode}: {tail}")
    return proc.stdout or ""


def toggle(kind: str, item_id: str, agent: str, on: bool) -> None:
    if kind not in ("skills", "mcp"):
        raise AdapterError(ERR_BAD_REQUEST, f"toggle unsupported for kind: {kind}")
    verb = "enable" if on else "disable"
    argv = ["cc-switch", kind, verb, item_id, "-a", agent]
    _run_cli(argv)


def delete(kind: str, item_id: str) -> None:
    if kind == "skills":
        _run_cli(["cc-switch", "skills", "uninstall", item_id])
    elif kind == "mcp":
        # b7 手测 #1: `mcp delete` 的确认用 dialoguer（管道 y 无效，需真 TTY）。
        # 镜像内置 util-linux `script`：伪 PTY 执行并经 stdin 喂 y（实测通过）。
        inner = shlex.join(["cc-switch", "mcp", "delete", item_id])
        _run_cli(["script", "-qec", inner, "/dev/null"],
                 input_text="y\n", timeout=30.0)
    elif kind == "plugins":
        name = item_id.partition("@")[0]
        _run_cli(["claude-real", "plugin", "uninstall", name], timeout=120.0)
    else:
        raise AdapterError(ERR_BAD_REQUEST, f"unknown kind: {kind}")


def skill_install(spec: str) -> None:
    _run_cli(["cc-switch", "skills", "install", spec], timeout=120.0)


def mcp_add(config_json: str, apps: list[str]) -> str:
    try:
        parsed = json.loads(config_json)
        if not isinstance(parsed, dict) or not isinstance(parsed.get("mcpServers"), dict):
            raise ValueError("config must be an object with an mcpServers object")
    except (json.JSONDecodeError, ValueError) as exc:
        raise AdapterError(ERR_BAD_REQUEST, f"invalid MCP config: {exc}")
    unknown = [a for a in apps if a not in AGENTS]
    if unknown:
        raise AdapterError(ERR_BAD_REQUEST, f"unsupported apps: {unknown}")
    encoded = base64.urlsafe_b64encode(config_json.encode("utf-8")).decode("ascii")
    url = (
        "ccswitch://v1/import?resource=mcp&config="
        + urllib.parse.quote(encoded, safe="")
        + "&apps=" + ",".join(apps)
    )
    _run_cli(["cc-switch", "deeplink", url], timeout=30.0)
    return url


def plugin_install(plugin_id: str) -> None:
    if "@" not in plugin_id:
        raise AdapterError(ERR_BAD_REQUEST, "plugin id must be name@marketplace")
    _run_cli(["claude-real", "plugin", "install", plugin_id], timeout=180.0)


def plugin_update(plugin_id: str) -> None:
    name = plugin_id.partition("@")[0]
    _run_cli(["claude-real", "plugin", "update", name], timeout=180.0)


