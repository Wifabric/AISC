#!/bin/bash
# Codex 包装器：每次启动 Codex 前从配置注入环境变量
# 类似 claude-wrapper，但适配 Codex 的配置结构
set -e

source /usr/local/bin/lib/env-inject.sh

# Codex 配置目录（类似 Claude 的 CLAUDE_CONFIG_DIR）
CODEX_CONFIG_DIR="${CODEX_CONFIG_DIR:-/root/app/.codex}"
CODEX_SETTINGS="${CODEX_CONFIG_DIR}/settings.json"

# 如果存在 Codex 专用配置，从中注入环境变量
# Codex 使用 OPENAI_API_KEY 等环境变量
if [ -f "$CODEX_SETTINGS" ]; then
    env_inject "$CODEX_SETTINGS"
fi

# 2.1.9 O9-反馈 #5a (2026-09-02): 清屏（含回滚缓冲）——bash/zsh 手动唤起
# 清屏；Workbench codex 页签直启（AISC_AGENT=codex）不受影响（详见
# claude-wrapper 同段注释）。
if [ -t 1 ] && [ "${AISC_AGENT:-manual}" != "codex" ]; then
    clear 2>/dev/null || printf '\033[H\033[2J\033[3J'
fi

# 容器本身是外部沙箱（IS_SANDBOX=1），默认给 Codex 完全执行权限，
# 与 Claude 的 --dangerously-skip-permissions 模式保持一致。
# 若用户显式指定权限/沙箱参数，则尊重用户选择，不再追加默认值。
#
# codex-adapt (2026-08-20): --dangerously-bypass-hook-trust REMOVED — the
# container image ships no codex hooks (probed live), so the flag changed
# nothing except a startup warning every session ("Enabled hooks may run
# without review"). Approval bypass alone keeps the headless behavior.
full_access_flags=(
    "--dangerously-bypass-approvals-and-sandbox"
)
has_permission_flag=0
for a in "$@"; do
    case "$a" in
        --dangerously-bypass-approvals-and-sandbox|\
        --sandbox|--sandbox=*|-s|\
        --ask-for-approval|--ask-for-approval=*|-a)
            has_permission_flag=1
            break
            ;;
    esac
done

# b1 (2.1.16 反馈 #10): CLI 内 npm install -g 自更新把新二进制装到
# NPM_CONFIG_PREFIX 指向的 toolchain prefix（project=/opt/aisc/toolchain，
# temporary/exec 会话=/tmp/aisc-toolchain）。按 会话 prefix → 持久 → 临时
# 顺序解析，命中即 exec；全部未命中才回退出厂 codex-real。wrapper 自身
# 永远留在 /usr/local/bin 解析链上，settings.json 注入不因更新旁路。
real_bin=""
for candidate in \
    "${NPM_CONFIG_PREFIX:-/nonexistent}/bin/codex" \
    /opt/aisc/toolchain/npm-global/bin/codex \
    /tmp/aisc-toolchain/npm-global/bin/codex; do
    if [ -x "$candidate" ]; then
        real_bin="$candidate"
        break
    fi
done

if [ -n "$real_bin" ]; then
    # b13: Docker Desktop's project bind mount cannot rename the @openai/codex
    # directory while Codex is executing from it (`codex update` → EACCES).
    # Copy the complete @openai scope into the container filesystem and run
    # that shadow entrypoint; npm still installs to the persistent prefix.
    case "$real_bin" in
        /opt/aisc/toolchain/npm-global/bin/codex)
            resolved_bin="$(readlink -f "$real_bin")"
            pkg_root="$(dirname "$(dirname "$resolved_bin")")"
            scope_root="$(dirname "$pkg_root")"
            shadow_root=/tmp/aisc-codex-shadow
            shadow_entry="$shadow_root/@openai/codex/bin/codex.js"
            rm -rf "$shadow_root"
            mkdir -p "$shadow_root"
            cp -a "$scope_root" "$shadow_root/"
            export CODEX_MANAGED_BY_NPM=1
            if [ "$has_permission_flag" = "0" ]; then
                exec node "$shadow_entry" "${full_access_flags[@]}" "$@"
            else
                exec node "$shadow_entry" "$@"
            fi
            ;;
        *)
            if [ "$has_permission_flag" = "0" ]; then
                exec "$real_bin" "${full_access_flags[@]}" "$@"
            else
                exec "$real_bin" "$@"
            fi
            ;;
    esac
fi

if [ "$has_permission_flag" = "0" ]; then
    exec codex-real "${full_access_flags[@]}" "$@"
else
    exec codex-real "$@"
fi
